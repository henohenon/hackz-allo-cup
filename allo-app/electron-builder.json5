// @see - https://www.electron.build/configuration/configuration
{
  // noble/bleno は N-API prebuild 同梱でリビルド不要。不要な node-gyp(=Python) 起動を防ぐ
  npmRebuild: false,
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.henohenon.kotohakobi",
  asar: true,
  // ネイティブモジュール (noble/bleno) は asar から展開しておく
  asarUnpack: ["**/node_modules/@stoprocent/**"],
  productName: "Kotohakobi",
  directories: {
    output: "release/${version}",
  },
  files: ["dist", "dist-electron"],
  mac: {
    target: ["dmg"],
    artifactName: "${productName}-Mac-${version}-Installer.${ext}",
    // BLE 利用のための権限説明 (macOS の許可ダイアログに表示される)
    extendInfo: {
      CFBundleDisplayName: "コトハコビ",
      NSBluetoothAlwaysUsageDescription: "近くの端末とメッセージを交換するために Bluetooth を使用します。",
      NSBluetoothPeripheralUsageDescription: "近くの端末とメッセージを交換するために Bluetooth を使用します。",
    },
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "${productName}-Windows-${version}-Setup.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ["AppImage"],
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
