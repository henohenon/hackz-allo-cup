{
  "name": "allo-app",
  "version": "0.0.0",
  "private": true,
  "description": "コトハコビ - 近くの端末と BLE でメッセージを交換するアプリ",
  "author": "henohenon",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build && electron-builder --publish never",
    "build:web": "tsc && vp build",
    "pack:dir": "vp build && electron-builder --dir",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "preview": "vp preview",
    "cap:sync": "vp run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "vp run cap:sync && cd android && ./gradlew assembleRelease --no-daemon"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@stoprocent/bleno": "^0.12.5",
    "@stoprocent/noble": "^2.5.5",
    "matter-js": "^0.20.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@11.8.0"
}
